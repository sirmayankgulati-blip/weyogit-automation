# Required
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=

# Required only when PUBLISH_TO_INSTAGRAM=true
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# YouTube OAuth upload is enabled by default. The uploaded client-secret file
# is discovered automatically from attached_assets/ when there is one match.
YOUTUBE_UPLOAD_ENABLED=true
YOUTUBE_CLIENT_SECRET_FILE=
YOUTUBE_TOKEN_FILE=state/youtube_token.json
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=25
YOUTUBE_PLAYLIST_ID=

# Other defaults
TELEGRAM_CHANNEL_USERNAME=@weyogitforyou
GEMINI_MODEL=gemini-2.5-flash
EDGE_TTS_VOICE=hi-IN-SwaraNeural
PUBLISH_TO_INSTAGRAM=false
OUTPUT_DIR=output
STATE_FILE=state/telegram_state.json
INSTAGRAM_SESSION_FILE=session.json
POLL_SECONDS=5
REQUEST_TIMEOUT=60
LOG_LEVEL=INFO